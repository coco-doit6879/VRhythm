{
  "name": "vrhythm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:audio": "node --experimental-strip-types --test tests/instrumentSynth.test.mjs tests/musicLibrary.test.mjs",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name vrhythm --branch main",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:ui": "playwright test --project=chromium-desktop --project=chromium-tablet --project=chromium-mobile",
    "test:ui:webkit": "playwright test --project=webkit-desktop --project=webkit-tablet --project=webkit-mobile"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wrangler": "^4.140.0"
  }
}
